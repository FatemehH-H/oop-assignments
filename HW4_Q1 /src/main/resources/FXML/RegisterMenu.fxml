<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: blue;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.RegisterMenuController">
   <children>
      <VBox alignment="CENTER" layoutX="142.0" layoutY="44.0" prefHeight="309.0" prefWidth="311.0" spacing="10.0">
         <children>
            <Label fx:id="welcomeText" alignment="CENTER" lineSpacing="10.0" prefHeight="17.0" prefWidth="241.0" text="Please Choose One Of The Maps below" textFill="#eeeb36" />
            <TextField fx:id="username" alignment="CENTER" promptText="userName" />
            <PasswordField alignment="CENTER" promptText="Password" />
            <Button mnemonicParsing="false" onMouseClicked="#register" text="Map 1" />
            <Button mnemonicParsing="false" onMouseClicked="#register2" text="Map 2" />
         </children>
      </VBox>
   </children>
</AnchorPane>
